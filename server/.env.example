# ==========================================
# FRIOO SERVER ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ==========================================
# SUPABASE CONFIGURATION (Required)
# ==========================================
# Your Supabase project URL
# Find this in: Supabase Dashboard > Settings > API > Project URL
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=your_supabase_project_url_here

# Supabase Service Role Key (Secret!)
# Find this in: Supabase Dashboard > Settings > API > service_role key
# WARNING: This key bypasses Row Level Security. Keep it secret!
# Used for: Server-side database operations, admin routes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# ==========================================
# ERROR TRACKING (Optional but Recommended for Production)
# ==========================================
# Sentry DSN for server-side error tracking
# Get this from: sentry.io > Project Settings > Client Keys (DSN)
# Example: https://abc123@o123456.ingest.sentry.io/123456
# Leave empty to disable error tracking
SENTRY_DSN=

# ==========================================
# SERVER CONFIGURATION (Optional)
# ==========================================
# Port the Express server will run on
# Default: 4000
# Change if 4000 is in use or for production deployment
PORT=4000

# Production frontend URL for CORS
# Used to whitelist your production frontend domain
# Example: https://frioo.vercel.app
# Leave empty for development (localhost is always allowed)
PRODUCTION_URL=

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# Development:
#   1. Copy this file: cp .env.example .env
#   2. Fill in Supabase credentials from your project
#   3. Run: npm run dev
#
# Production:
#   1. Set environment variables in your hosting platform
#   2. Ensure PRODUCTION_URL matches your frontend domain
#   3. Use a strong, unique SUPABASE_SERVICE_ROLE_KEY
#
# Security Checklist:
#   - Never commit .env to git (already in .gitignore)
#   - Rotate keys if accidentally exposed
#   - Use different Supabase projects for dev/prod
#   - Enable rate limiting in production (already configured)
