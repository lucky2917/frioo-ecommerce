# ==========================================
# FRIOO CLIENT ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your actual values
# NOTE: Vite exposes variables starting with VITE_ to the browser
# DO NOT put sensitive secrets here (use server .env for that)

# ==========================================
# SUPABASE CONFIGURATION (Required)
# ==========================================
# Your Supabase project URL
# Find this in: Supabase Dashboard > Settings > API > Project URL
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase Anonymous/Public Key (Safe to expose)
# Find this in: Supabase Dashboard > Settings > API > anon/public key
# This key is safe to use in the browser (respects Row Level Security)
# Used for: Client-side authentication, user data fetching
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# ERROR TRACKING (Optional but Recommended for Production)
# ==========================================
# Sentry DSN for client-side error tracking
# Get this from: sentry.io > Project Settings > Client Keys (DSN)
# Use the SAME project as server or create separate client project
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# ==========================================
# API CONFIGURATION (Optional)
# ==========================================
# Backend API URL for production
# Development: Auto-detects as http://localhost:4000
# Production: Set to your deployed backend URL
# Example: https://frioo-api.onrender.com
# Leave empty to use localhost:4000 in dev
VITE_API_URL=

# ==========================================
# RELEASE TAGGING (Optional)
# ==========================================
# Ties browser errors in Sentry to a specific deploy.
# On Vercel set this to $VERCEL_GIT_COMMIT_SHA
VITE_COMMIT_SHA=

# Fallback release label when no commit sha is available
VITE_APP_VERSION=

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# Development:
#   1. Copy this file: cp .env.example .env
#   2. Fill in Supabase credentials (same project as server)
#   3. Leave VITE_API_URL empty for local development
#   4. Run: npm run dev
#
# Production Build:
#   1. Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
#   2. Set VITE_API_URL to your production backend URL
#   3. Build: npm run build
#   4. Deploy dist/ folder to CDN/hosting platform
#
# Environment Variables in Vite:
#   - Only VITE_* variables are exposed to the browser
#   - Access via: import.meta.env.VITE_VARIABLE_NAME
#   - Changes require dev server restart
#
# Security Notes:
#   - Never put service role keys here (they're secret!)
#   - VITE_SUPABASE_ANON_KEY is safe to expose (public key)
#   - All VITE_* vars are public in production bundle
