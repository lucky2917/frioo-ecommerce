{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.frioo.in" }],
            "destination": "https://frioo.in/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}